# Auth Rate Limit (for development)
AUTH_RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW=15

# Server
PORT=3005
NODE_ENV=development

# Base URL the backend uses when it builds absolute URLs for uploaded files.
# Local development: the frontend runs on :3000 and calls this server on :3005.
API_BASE_URL=http://localhost:3005

# JWT
JWT_SECRET=thiennhan-super-secret-key-2024-change-in-production
JWT_EXPIRES_IN=7d

# Database
DATABASE_URL="mongodb+srv://b0994123456_db_user:GbfrHGnCZxL1vYYe@cluster0.youy4mc.mongodb.net/thiennhan_db?retryWrites=true&w=majority&appName=Cluster0"

# Demo OTP (for development)
DEMO_OTP=123456

# Email provider: 'smtp' (Gmail/Nodemailer - local dev) or 'resend' (hosted API).
# MUST be set: the default is 'resend', and RESEND_API_KEY is not configured,
# so leaving this unset silently routes every OTP to a transport that has no
# credentials and delivers nothing.
EMAIL_PROVIDER=smtp

# Resend (only used when EMAIL_PROVIDER=resend)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="Thiên Nhãn Trú Đồ <no-reply@thiennhan.vn>"

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=thiennhantrudocskh@gmail.com
SMTP_PASS=ihop hfwk cvyy cdfd
# From address used for every outgoing e-mail. Defaults to SMTP_USER when unset.
SMTP_FROM_EMAIL="Thiên Nhãn Trú Đồ <thiennhantrudocskh@gmail.com>"

# Frontend URL (for CORS) - FE chạy trên Vercel, BE chạy local
FRONTEND_URL=*

# VNPay Configuration (for payment)
VNPAY_TMN_CODE=THIENNHAN
